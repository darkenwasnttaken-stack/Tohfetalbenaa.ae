# ============================================================================
#  Tohfet Al Benaa — contact form configuration
#  ----------------------------------------------------------------------------
#  1. Copy this file to  .env   (same folder)
#  2. Fill in the blank values below
#  3. Never commit .env — it is git-ignored and blocked from the web by .htaccess
#
#  Any of these can instead be set as real server environment variables
#  (Hostinger hPanel), which take priority over the .env file.
# ============================================================================

# ---- SMTP server (confirmed with Tasjeel / Qamar) --------------------------
# Host / port / encryption / username are known. Only the PASSWORD is secret:
# put the real password for info@tohfetalbenaa.ae in your local .env file,
# never here and never in any committed file.
# NOTE: values run to the end of the line — do NOT add "# comments" after a
# value (a password may legitimately contain "#").
TAB_SMTP_HOST=mail.tohfetalbenaa.ae
TAB_SMTP_PORT=465
TAB_SMTP_SECURE=ssl
TAB_SMTP_USER=info@tohfetalbenaa.ae
# Replace the placeholder below with the real mailbox password (in .env only):
TAB_SMTP_PASS=YOUR_EMAIL_PASSWORD
TAB_SMTP_AUTH=true

# ---- Addresses ----------------------------------------------------------
# FROM must be a real mailbox on tohfetalbenaa.ae (needed for SMTP auth and so
# the message passes SPF/DKIM). It is NOT the visitor's address.
TAB_MAIL_FROM=info@tohfetalbenaa.ae
TAB_MAIL_FROM_NAME=Tohfet Al Benaa Website

# Where inquiries are delivered (can be the same mailbox as FROM):
TAB_MAIL_TO=info@tohfetalbenaa.ae
TAB_MAIL_TO_NAME=Tohfet Al Benaa

# ---- Anti-abuse (defaults are fine for a small business site) -------------
TAB_ALLOWED_ORIGINS=tohfetalbenaa.ae,www.tohfetalbenaa.ae
# a submission faster than this many seconds is treated as a bot
TAB_FORM_MIN_SECONDS=3
# max submissions per visitor IP per hour
TAB_MAX_PER_HOUR=5
# an identical re-submission within this many minutes is ignored (no 2nd email)
TAB_DEDUPE_MINUTES=10

# ---- Debugging --------------------------------------------------------
# Set to true ONLY while diagnosing a send failure: it returns the raw SMTP
# error to the browser and writes a full SMTP transcript to storage/mail.log.
# Set back to false afterwards.
TAB_MAIL_DEBUG=false
