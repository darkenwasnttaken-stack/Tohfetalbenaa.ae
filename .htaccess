# ============================================================================
#  Tohfet Al Benaa — Apache / LiteSpeed configuration (Hostinger)
#  Static marketing site + one PHP contact endpoint (contact-handler.php)
# ============================================================================

DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
Options -Indexes

# ---- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Never serve secrets, config, libraries, runtime data ----------------
# Directories (Apache 2.4 / LiteSpeed):
RedirectMatch 403 (?i)^/(config|lib|storage|vendor|\.git)(/|$)

# Individual sensitive files:
<FilesMatch "(?i)(^\.env$|^\.env\.|(^|/)composer\.(json|lock)$|\.md$|^\.gitignore$|^\.gitattributes$|\.log$)">
  Require all denied
</FilesMatch>

# Hard stop for the environment file specifically (belt & braces):
<Files ".env">
  Require all denied
</Files>

# ---- Canonical host + HTTPS ------------------------------------------
# Serve everything from ONE origin: https://tohfetalbenaa.ae/...
# Without this, http:// and www. copies stay reachable with a 200 and
# Google indexes them as separate duplicates of every page. Runs BEFORE
# the clean-URL rules so it fires on the raw external request.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.tohfetalbenaa\.ae$ [NC]
  RewriteRule ^ https://tohfetalbenaa.ae%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Clean URLs: /about instead of /about.html --------------------------
# 1. Send any direct *.html request to its extensionless URL (301, canonical).
# 2. Serve the matching .html file for an extensionless request.
# PHP endpoints, real files and real directories are left untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html or /<dir>/index.html  ->  /  or  /<dir>/
  RewriteCond %{THE_REQUEST} \s/+(([^?\s]+/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /<path>.html  ->  /<path>
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /<path>/  ->  /<path>   (drop a trailing slash on non-directories so that
  # relative asset paths on the clean URLs always resolve the same way)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ /$1 [R=301,L]

  # /<path>  ->  /<path>.html  (internal, only when the .html file exists)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# ---- Static asset caching ----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg            "access plus 30 days"
  ExpiresByType image/png            "access plus 30 days"
  ExpiresByType image/webp           "access plus 30 days"
  ExpiresByType image/x-icon         "access plus 30 days"
</IfModule>
