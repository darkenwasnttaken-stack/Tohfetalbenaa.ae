# ============================================================================
#  Tohfet Al Benaa — Apache / LiteSpeed configuration (Hostinger)
#  Static marketing site + one PHP contact endpoint (contact-handler.php)
# ============================================================================

DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
Options -Indexes

# ---- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Never serve secrets, config, libraries, runtime data ----------------
# Directories (Apache 2.4 / LiteSpeed):
RedirectMatch 403 (?i)^/(config|lib|storage|vendor|\.git)(/|$)

# Individual sensitive files:
<FilesMatch "(?i)(^\.env$|^\.env\.|(^|/)composer\.(json|lock)$|\.md$|^\.gitignore$|^\.gitattributes$|\.log$)">
  Require all denied
</FilesMatch>

# Hard stop for the environment file specifically (belt & braces):
<Files ".env">
  Require all denied
</Files>

# ---- Optional: force HTTPS + canonical host (uncomment after go-live) -----
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} ^www\.tohfetalbenaa\.ae$ [NC]
#   RewriteRule ^ https://tohfetalbenaa.ae%{REQUEST_URI} [R=301,L]
# </IfModule>

# ---- Static asset caching ----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg            "access plus 30 days"
  ExpiresByType image/png            "access plus 30 days"
  ExpiresByType image/webp           "access plus 30 days"
  ExpiresByType image/x-icon         "access plus 30 days"
</IfModule>
